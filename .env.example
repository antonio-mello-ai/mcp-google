# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# JSON array of accounts with refresh tokens
# Obtain refresh tokens via OAuth2 flow (see README.md)
GOOGLE_ACCOUNTS_JSON='[{"email": "personal@gmail.com", "refresh_token": "1//your-refresh-token"}, {"email": "work@company.com", "refresh_token": "1//another-refresh-token"}]'
